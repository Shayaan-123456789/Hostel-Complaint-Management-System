# Copy to .env, replace every placeholder, and never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
HOSTEL_JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHARACTER_SECRET
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
HOSTEL_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Configure a 64-bit Oracle ODBC DSN in your OS ODBC Data Source Administrator.
# It should point to the schema that has the nine project tables/procedures.
ORACLE_ODBC_DSN=SmartHostelOracle
ORACLE_DB_USER=HOSTEL_APP
ORACLE_DB_PASSWORD=REPLACE_ME

# Leave blank when the Oracle login owns the nine tables.
# If a different Oracle user owns them, specify its schema name AND grant object access.
ORACLE_SCHEMA_OWNER=

# Choose the warden/admin login username and a Django PBKDF2 password hash.
HOSTEL_ADMIN_USERNAME=warden
HOSTEL_ADMIN_PASSWORD_HASH=REPLACE_WITH_HASH_FROM_SCRIPTS
HOSTEL_TOKEN_HOURS=4
HOSTEL_MAX_UPLOAD_MB=5
