    {
      "name": "04 Warden login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"WARDEN\",\n  \"username\": \"{{wardenUsername}}\",\n  \"password\": \"{{wardenPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('wardenToken', body.access_token);",
              "}"
            ]
          }
        }
      ]
    },
